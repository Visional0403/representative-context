{
  "checkpoint": "weights/twins/twins_svt_s_imagenet.pth",
  "data_root": "datasets/UAVid",
  "default_hooks": {
    "checkpoint": {
      "by_epoch": false,
      "interval": 2500,
      "max_keep_ckpts": -1,
      "rule": "greater",
      "save_best": "mIoU",
      "save_last": true,
      "type": "CheckpointHook"
    },
    "logger": {
      "interval": 50,
      "log_metric_by_epoch": false,
      "type": "LoggerHook"
    },
    "param_scheduler": {
      "type": "ParamSchedulerHook"
    },
    "sampler_seed": {
      "type": "DistSamplerSeedHook"
    },
    "timer": {
      "type": "IterTimerHook"
    },
    "visualization": {
      "type": "SegVisualizationHook"
    }
  },
  "default_scope": "mmseg",
  "env_cfg": {
    "cudnn_benchmark": false,
    "dist_cfg": {
      "backend": "nccl"
    },
    "mp_cfg": {
      "mp_start_method": "fork",
      "opencv_num_threads": 0
    }
  },
  "log_level": "INFO",
  "log_processor": {
    "by_epoch": false
  },
  "model": {
    "backbone": {
      "attn_drop_rate": 0.0,
      "depths": [
        2,
        2,
        10,
        4
      ],
      "drop_path_rate": 0.2,
      "drop_rate": 0.0,
      "embed_dims": [
        64,
        128,
        256,
        512
      ],
      "in_channels": 3,
      "init_cfg": {
        "type": "Pretrained",
        "checkpoint": "weights/twins/twins_svt_s_imagenet.pth"
      },
      "mlp_ratios": [
        4,
        4,
        4,
        4
      ],
      "norm_after_stage": true,
      "norm_cfg": {
        "type": "LN"
      },
      "num_heads": [
        2,
        4,
        8,
        16
      ],
      "out_indices": [
        0,
        1,
        2,
        3
      ],
      "patch_sizes": [
        4,
        2,
        2,
        2
      ],
      "qkv_bias": true,
      "sr_ratios": [
        8,
        4,
        2,
        1
      ],
      "strides": [
        4,
        2,
        2,
        2
      ],
      "type": "SVT",
      "windiow_sizes": [
        7,
        7,
        7,
        7
      ]
    },
    "data_preprocessor": {
      "bgr_to_rgb": true,
      "mean": [
        123.675,
        116.28,
        103.53
      ],
      "pad_val": 0,
      "seg_pad_val": 255,
      "size": [
        1024,
        1024
      ],
      "std": [
        58.395,
        57.12,
        57.375
      ],
      "type": "SegDataPreProcessor"
    },
    "decode_head": {
      "align_corners": false,
      "channels": 128,
      "dropout_ratio": 0.1,
      "feature_strides": [
        4,
        8,
        16,
        32
      ],
      "in_channels": [
        256,
        256,
        256,
        256
      ],
      "in_index": [
        0,
        1,
        2,
        3
      ],
      "loss_decode": {
        "loss_weight": 1.0,
        "type": "CrossEntropyLoss",
        "use_sigmoid": false
      },
      "norm_cfg": {
        "requires_grad": true,
        "type": "SyncBN"
      },
      "num_classes": 8,
      "type": "FPNHead"
    },
    "neck": {
      "in_channels": [
        64,
        128,
        256,
        512
      ],
      "num_outs": 4,
      "out_channels": 256,
      "type": "FPN"
    },
    "test_cfg": {
      "crop_size": [
        1024,
        1024
      ],
      "mode": "slide",
      "stride": [
        512,
        512
      ]
    },
    "train_cfg": {},
    "type": "EncoderDecoder"
  },
  "optim_wrapper": {
    "clip_grad": {
      "max_norm": 1.0,
      "norm_type": 2
    },
    "loss_scale": "dynamic",
    "optimizer": {
      "lr": 0.0001,
      "type": "AdamW",
      "weight_decay": 0.0001
    },
    "type": "AmpOptimWrapper"
  },
  "optimizer": {
    "lr": 0.01,
    "momentum": 0.9,
    "type": "SGD",
    "weight_decay": 0.0005
  },
  "param_scheduler": [
    {
      "begin": 0,
      "by_epoch": false,
      "end": 1000,
      "start_factor": 0.1,
      "type": "LinearLR"
    },
    {
      "begin": 1000,
      "by_epoch": false,
      "end": 80000,
      "eta_min": 1e-06,
      "power": 0.9,
      "type": "PolyLR"
    }
  ],
  "randomness": {
    "deterministic": false,
    "seed": 42
  },
  "test_cfg": {
    "type": "TestLoop"
  },
  "test_dataloader": {
    "batch_size": 1,
    "dataset": {
      "data_root": "datasets/UAVid",
      "pipeline": [
        {
          "type": "LoadImageFromFile"
        },
        {
          "type": "LoadUAVidColorAnnotations"
        },
        {
          "type": "PackSegInputs"
        }
      ],
      "split": "val",
      "test_mode": true,
      "type": "UAVidSequenceDataset"
    },
    "num_workers": 2,
    "persistent_workers": true,
    "sampler": {
      "shuffle": false,
      "type": "DefaultSampler"
    }
  },
  "test_evaluator": {
    "iou_metrics": [
      "mIoU"
    ],
    "type": "IoUMetric"
  },
  "train_cfg": {
    "max_iters": 80000,
    "type": "IterBasedTrainLoop",
    "val_interval": 2500
  },
  "train_dataloader": {
    "batch_size": 1,
    "dataset": {
      "data_root": "datasets/UAVidCrops",
      "pipeline": [
        {
          "type": "LoadImageFromFile"
        },
        {
          "type": "LoadUAVidColorAnnotations"
        },
        {
          "keep_ratio": true,
          "ratio_range": [
            0.8,
            1.2
          ],
          "scale": [
            1024,
            1024
          ],
          "type": "RandomResize"
        },
        {
          "cat_max_ratio": 0.75,
          "crop_size": [
            1024,
            1024
          ],
          "type": "RandomCrop"
        },
        {
          "prob": 0.5,
          "type": "RandomFlip"
        },
        {
          "type": "PhotoMetricDistortion"
        },
        {
          "type": "PackSegInputs"
        }
      ],
      "split": "train",
      "type": "UAVidSequenceDataset"
    },
    "num_workers": 2,
    "persistent_workers": true,
    "sampler": {
      "shuffle": true,
      "type": "InfiniteSampler"
    }
  },
  "val_cfg": {
    "type": "ValLoop"
  },
  "val_dataloader": {
    "batch_size": 1,
    "dataset": {
      "data_root": "datasets/UAVid",
      "pipeline": [
        {
          "type": "LoadImageFromFile"
        },
        {
          "type": "LoadUAVidColorAnnotations"
        },
        {
          "type": "PackSegInputs"
        }
      ],
      "split": "val",
      "test_mode": true,
      "type": "UAVidSequenceDataset"
    },
    "num_workers": 2,
    "persistent_workers": true,
    "sampler": {
      "shuffle": false,
      "type": "DefaultSampler"
    }
  },
  "val_evaluator": {
    "iou_metrics": [
      "mIoU"
    ],
    "type": "IoUMetric"
  },
  "visualizer": {
    "name": "visualizer",
    "type": "SegLocalVisualizer",
    "vis_backends": [
      {
        "type": "LocalVisBackend"
      }
    ]
  },
  "custom_imports": {
    "imports": [
      "representative_context.data.uavid_mmseg"
    ],
    "allow_failed_imports": false
  }
}
